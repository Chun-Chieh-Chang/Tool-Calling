{
  "name": "tool-calling",
  "version": "1.0.0",
  "description": "全自動工具調用效能外掛系統 - 擁有 722 個頂尖開源 AI 代理技能與工具的檢索庫與儀表板",
  "main": "cli.js",
  "type": "module",
  "bin": {
    "tool-calling": "./cli.js",
    "tool-calling-mcp": "./mcp-server.js"
  },
  "scripts": {
    "start": "node web/server.js",
    "dev": "node web/server.js --dev",
    "build": "node scripts/build-web.js",
    "test": "node scripts/check-syntax.js && node scripts/check-utf8.js && node scripts/check-duplicate-ids.js && node scripts/check-traditional.js && node scripts/check-traditional.js --full --code && node --test --test-concurrency=1 tests/*.test.js",
    "test:integration": "node --test --test-concurrency=1 tests/*.test.js",
    "check:lang": "node scripts/check-traditional.js",
    "check:lang:full": "node scripts/check-traditional.js --full",
    "check:lang:commits": "node scripts/check-traditional.js --commits HEAD~5..HEAD",
    "validate": "node cli.js validate",
    "check-mece": "node scripts/check-mece.js",
    "enrich": "node scripts/enrich-registry.js",
    "reclassify": "node scripts/hook-reclassify.js",
    "trending": "node scripts/trending-weekly.js",
    "daemon": "node scripts/sync-daemon.js",
    "mine-synonyms": "node scripts/mine-synonyms.js",
    "translate:zh": "node scripts/translate-to-zh.js",
    "agents:init": "node scripts/generate-agents-md.js",
    "tracked-repos": "node scripts/tracked-repos.js",
    "rescan-classification": "node scripts/rescan-classification.js",
    "discriminability": "node scripts/measure-discriminability.js",
    "aurora:proto": "node scripts/prototype-aurora-clusters.js",
    "categories:sync": "node scripts/sync-categories.js",
    "categories:check": "node scripts/sync-categories.js --check",
    "mcp": "node mcp-server.js",
    "plugin:install": "node scripts/install-plugin.js",
    "embed:build": "node scripts/embed-build.js",
    "benchmark": "node scripts/eval-benchmark.js",
    "eval:rerank": "node scripts/eval-rerank.js",
    "lint": "echo \"No linter configured, skipping...\"",
    "ceiling": "node scripts/ceiling-analysis.js",
    "compile:wiki": "node scripts/compile-wiki.js",
    "enrich:new": "node scripts/enrich-new-tools.js",
    "ablate:v5": "node scripts/v5-ablate.js"
  },
  "keywords": [
    "ai",
    "agent",
    "tool-calling",
    "claude-code",
    "cursor",
    "mcp",
    "llm",
    "gpt",
    "openai",
    "anthropic",
    "gemini",
    "autogpt",
    "skills",
    "toolkit",
    "automation",
    "workflow"
  ],
  "author": "chun-chieh-chang",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "opencc-js": "^1.4.2",
    "playwright": "^1.62.1"
  }
}
